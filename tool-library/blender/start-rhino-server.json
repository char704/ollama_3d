{
  "schema_version": 1,
  "id": "start_rhino_server",
  "name": "Start Rhino Server",
  "description": "Khởi động Rhino Server của công ty trong Blender khi người dùng yêu cầu kết nối hoặc sử dụng Rhino Server.",
  "executor": "blender_operator",
  "operator": "blender_rhino_server.start",
  "enabled": true,
  "execution_mode": "persistent",
  "load_model": false,
  "save_after": false,
  "timeout_seconds": 30,
  "parameters": {
    "server_adr": {
      "type": "string",
      "description": "Địa chỉ server local.",
      "default": "127.0.0.1",
      "enum": ["127.0.0.1"]
    },
    "server_port": {
      "type": "integer",
      "description": "Cổng lắng nghe của Rhino Server.",
      "default": 55555,
      "minimum": 1024,
      "maximum": 65535
    }
  }
}
