{
  "schema_version": 1,
  "id": "add_cube",
  "name": "Add Cube",
  "description": "Tạo một khối cube bằng operator có sẵn của Blender và lưu file kết quả. Dùng khi người dùng yêu cầu tạo cube hoặc kiểm tra Blender Agent.",
  "executor": "blender_operator",
  "operator": "mesh.primitive_cube_add",
  "enabled": true,
  "execution_mode": "one_shot",
  "load_model": false,
  "save_after": true,
  "timeout_seconds": 30,
  "parameters": {
    "size": {
      "type": "number",
      "description": "Kích thước cạnh cube.",
      "default": 2.0,
      "minimum": 0.01,
      "maximum": 100.0
    }
  }
}
