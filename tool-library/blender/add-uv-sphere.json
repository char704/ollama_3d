{
  "schema_version": 1,
  "id": "add_uv_sphere",
  "name": "Add UV Sphere",
  "description": "Tạo một UV sphere bằng operator có sẵn của Blender và lưu file kết quả. Dùng khi người dùng yêu cầu tạo hình cầu hoặc kiểm tra Blender Agent.",
  "executor": "blender_operator",
  "operator": "mesh.primitive_uv_sphere_add",
  "enabled": true,
  "execution_mode": "one_shot",
  "load_model": false,
  "save_after": true,
  "timeout_seconds": 30,
  "parameters": {
    "segments": {
      "type": "integer",
      "description": "Số đoạn quanh hình cầu.",
      "default": 32,
      "minimum": 8,
      "maximum": 128
    },
    "ring_count": {
      "type": "integer",
      "description": "Số vòng theo chiều dọc.",
      "default": 16,
      "minimum": 4,
      "maximum": 64
    }
  }
}
