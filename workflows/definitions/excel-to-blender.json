{
  "schema_version": 1,
  "id": "excel_to_blender",
  "name": "Excel BOM to verified Blender model",
  "description": "Export Excel to VBOM, apply it to a Blender model and verify the saved result.",
  "steps": [
    {
      "id": "export_vbom",
      "action": "export",
      "timeout_seconds": 120,
      "retry_safe": true,
      "required": true
    },
    {
      "id": "apply_and_verify",
      "action": "apply",
      "timeout_seconds": 300,
      "retry_safe": false,
      "required": true
    }
  ]
}
