{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/workflow.schema.json",
  "title": "Workflow Definition",
  "type": "object",
  "required": ["schema_version", "id", "name", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "timeout_seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "retry_safe": {"type": "boolean"},
          "required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
