{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/tool-manifest.schema.json",
  "title": "Local Tool Manifest",
  "type": "object",
  "required": ["schema_version", "id", "name", "description", "executor", "enabled"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "executor": {
      "enum": ["blender_operator", "http", "python", "cli", "excel_com"]
    },
    "enabled": {"type": "boolean"},
    "exposed_to_model": {"type": "boolean"},
    "parameters": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"executor": {"const": "blender_operator"}},
        "required": ["executor"]
      },
      "then": {
        "required": ["operator", "execution_mode", "load_model", "save_after", "timeout_seconds"],
        "properties": {
          "operator": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
          },
          "execution_mode": {"enum": ["one_shot", "persistent"]},
          "load_model": {"type": "boolean"},
          "save_after": {"type": "boolean"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
        }
      }
    }
  ],
  "additionalProperties": true
}
