{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/job.schema.json",
  "title": "Workflow Job",
  "type": "object",
  "required": ["job_id", "status", "created_at"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
    "status": {
      "enum": [
        "queued",
        "running",
        "exporting",
        "validating",
        "applying",
        "verifying",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "current_step": {"type": ["string", "null"]},
    "input": {"type": "object"},
    "output": {"type": "object"},
    "error": {"type": ["string", "null"]},
    "idempotency_key": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
