{
  "profile": "demo",
  "paths": {
    "inputs": "inputs",
    "outputs": "oputs",
    "default_model": "inputs/Sneaker_Unassigned.blend",
    "blender_exe": "E:/Blender/blender.exe",
    "allowed_roots": []
  },
  "services": {
    "api_port": 8090,
    "webui_port": 8080,
    "ollama_url": "http://127.0.0.1:11434"
  },
  "ollama": {
    "model": "qwen2.5:7b",
    "executable": ""
  },
  "blender_agent": {
    "enabled": true,
    "startup_timeout_seconds": 60,
    "job_timeout_seconds": 120,
    "poll_interval_seconds": 0.2,
    "heartbeat_interval_seconds": 1.0,
    "hung_grace_seconds": 15,
    "max_queued_jobs": 25,
    "auto_restart_hung": true
  },
  "tool_library": {
    "directory": "tool-library"
  },
  "workflow": {
    "files": {"provider": "local"},
    "export": {"provider": "local"},
    "apply": {"provider": "local"},
    "result": {"provider": "local"}
  }
}
