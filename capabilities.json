{
  "schema_version": 1,
  "capabilities": [
    {
      "id": "system.status",
      "provider": "system",
      "handler": "system_status",
      "public_tool": "system_status",
      "target": "local.readiness",
      "instructions": "Dùng system_status chỉ khi người dùng hỏi trạng thái, phiên bản hoặc khả năng sẵn sàng.",
      "enabled": true
    },
    {
      "id": "excel.ping",
      "provider": "excel_vba",
      "handler": "ping",
      "target": "'Ollama3DProof.xlam'!Ollama3D_Ping",
      "version": "1.0.0",
      "enabled": true
    },
    {
      "id": "excel.export_vbom",
      "provider": "excel_vba",
      "handler": "export_vbom",
      "target": "'Ollama3DProof.xlam'!ExportVBOM",
      "version": "1.0.0",
      "enabled": true
    },
    {
      "id": "blender.apply_vbom",
      "provider": "blender_addon",
      "handler": "apply_vbom",
      "target": "ollama3d_proof.apply_vbom",
      "version": "1.0.0",
      "enabled": true
    },
    {
      "id": "blender.ollama3d_proof.apply_vbom",
      "provider": "blender_operator",
      "handler": "generic_operator",
      "target": "ollama3d_proof.apply_vbom",
      "addon_module": "ollama3d_proof_addon",
      "description": "Apply a validated proof-v1 VBOM file to the three footwear meshes.",
      "risk": "filesystem",
      "params": {
        "type": "object",
        "properties": {
          "filepath": {
            "type": "string",
            "x-path": true
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "filepath",
          "run_id"
        ],
        "additionalProperties": false
      },
      "expose": "generic",
      "background_safe": true,
      "enabled": true
    },
    {
      "id": "workflow.excel_to_blender",
      "provider": "workflow",
      "handler": "run_excel_to_blender",
      "public_tool": "run_excel_to_blender",
      "target": "workflow.excel_to_blender",
      "dependencies": [
        "excel.export_vbom",
        "blender.apply_vbom"
      ],
      "instructions": "Dùng run_excel_to_blender chỉ cho yêu cầu xử lý rõ ràng có đủ excel_path, model_path và output_dir tuyệt đối.",
      "enabled": true
    },
    {
      "id": "blender.create_colored_primitive",
      "provider": "blender_builtin",
      "handler": "create_colored_primitive",
      "public_tool": "create_colored_primitive",
      "target": "lab_mcp_runner.create_colored_primitive",
      "settings": {
        "primitives": [
          "cube",
          "uv_sphere",
          "cylinder"
        ],
        "minimum_size": 0.01,
        "maximum_size": 100
      },
      "instructions": "Dùng create_colored_primitive khi người dùng yêu cầu cube, UV sphere hoặc cylinder có màu và đã cung cấp output_dir tuyệt đối.",
      "enabled": true
    },
    {
      "id": "workflow.list_blender_capabilities",
      "provider": "workflow",
      "handler": "list_blender_capabilities",
      "public_tool": "list_blender_capabilities",
      "target": "workflow.list_blender_capabilities",
      "description": "List enabled generic Blender add-on capabilities and their parameter schemas.",
      "instructions": "Dùng list_blender_capabilities khi người dùng hỏi add-on Blender đang có chức năng gì; không tự bịa capability_id.",
      "enabled": true
    },
    {
      "id": "workflow.run_blender_operator",
      "provider": "workflow",
      "handler": "run_blender_operator",
      "public_tool": "run_blender_operator",
      "target": "workflow.run_blender_operator",
      "description": "Run one enabled allowlisted Blender operator through the generic verified workflow.",
      "instructions": "Chỉ dùng run_blender_operator sau khi có capability_id hợp lệ, params đúng schema, model_path .blend và output_dir tuyệt đối; nếu thiếu phải hỏi lại.",
      "enabled": true
    },
    {
      "id": "workflow.run_blender_workflow",
      "provider": "workflow",
      "handler": "run_blender_workflow",
      "public_tool": "run_blender_workflow",
      "target": "workflow.run_blender_workflow",
      "description": "Run a registered declarative multi-step Blender workflow in one verified session.",
      "instructions": "Chỉ dùng run_blender_workflow với workflow_id đã đăng ký và inputs đầy đủ; không tự tạo workflow_id hoặc biểu thức nội suy.",
      "enabled": true
    }
  ]
}
