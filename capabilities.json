{
  "schema_version": 1,
  "capabilities": [
    {
      "id": "system.status",
      "provider": "system",
      "handler": "system_status",
      "public_tool": "system_status",
      "target": "local.readiness",
      "enabled": true
    },
    {
      "id": "excel.ping",
      "provider": "excel_vba",
      "handler": "ping",
      "target": "'Ollama3DProof.xlam'!Ollama3D_Ping",
      "version": "1.0.0",
      "enabled": true
    },
    {
      "id": "excel.export_vbom",
      "provider": "excel_vba",
      "handler": "export_vbom",
      "target": "'Ollama3DProof.xlam'!ExportVBOM",
      "version": "1.0.0",
      "enabled": true
    },
    {
      "id": "blender.apply_vbom",
      "provider": "blender_addon",
      "handler": "apply_vbom",
      "target": "ollama3d_proof.apply_vbom",
      "version": "1.0.0",
      "enabled": true
    },
    {
      "id": "workflow.excel_to_blender",
      "provider": "workflow",
      "handler": "run_excel_to_blender",
      "public_tool": "run_excel_to_blender",
      "target": "workflow.excel_to_blender",
      "dependencies": [
        "excel.export_vbom",
        "blender.apply_vbom"
      ],
      "enabled": true
    },
    {
      "id": "blender.create_colored_primitive",
      "provider": "blender_builtin",
      "handler": "create_colored_primitive",
      "public_tool": "create_colored_primitive",
      "target": "lab_mcp_runner.create_colored_primitive",
      "settings": {
        "primitives": [
          "cube",
          "uv_sphere",
          "cylinder"
        ],
        "minimum_size": 0.01,
        "maximum_size": 100
      },
      "enabled": true
    }
  ]
}
